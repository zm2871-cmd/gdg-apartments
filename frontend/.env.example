VITE_DATA_PROVIDER=mock
# Required in API mode. Use /api when the backend is served through the same origin.
# VITE_API_BASE_URL=/api
# Optional public MapLibre style URL for real reports.
# VITE_MAP_STYLE_URL=
# Optional local development proxy. Server-side Vite configuration only.
# HEARTHSTONE_DEV_API_TARGET=http://localhost:3000

# Public Supabase client configuration. Use the same project as the backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy public anon key fallback, if your project still uses it.
# VITE_SUPABASE_ANON_KEY=
