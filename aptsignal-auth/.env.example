# Copy to .env.local. Insert only your Supabase project URL and PUBLISHABLE key.
# Never use a service-role key or sb_secret_* key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Must be the exact browser origin. Use port 3001 if running alongside AptSignal.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shared client/server password policy; mirror these requirements in Supabase Auth.
NEXT_PUBLIC_AUTH_MIN_PASSWORD_LENGTH=8
# No AI SDK, AI key, model integration or payment integration exists in this app.
